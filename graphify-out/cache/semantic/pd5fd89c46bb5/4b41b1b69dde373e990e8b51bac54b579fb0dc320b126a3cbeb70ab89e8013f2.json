{"nodes": [{"id": "_claude_skills_graphify_skill_graphifycommand", "label": "/graphify Command", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_structuralextraction", "label": "Structural (AST) Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_semanticextraction", "label": "Semantic (LLM) Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_geminibackend", "label": "Gemini Backend (extract_corpus_parallel)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_mergestep", "label": "Part C: Merge AST + Semantic", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_communitydetection", "label": "Community Detection (cluster)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_godnodes", "label": "God Nodes Analysis", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graphreport", "label": "GRAPH_REPORT.md Output", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graphjson", "label": "graph.json Output", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_shrinkguard", "label": "Shrink Guard (#479)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json() refuses to write graph.json if the new graph has fewer nodes than the existing one, so an empty/partial extraction never silently overwrites a good graph."}, {"id": "_claude_skills_graphify_skill_honestyrules", "label": "Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS when unsure), never skip the corpus size warning, always show token cost, never hide cohesion scores, never run HTML viz on >5000 nodes without warning - trust and auditability over impressiveness."}, {"id": "_claude_skills_graphify_skill_subagentdispatch", "label": "Parallel Subagent Dispatch (Step B2)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_extractioncache", "label": "Semantic Extraction Cache (Step B0)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_issue1392", "label": "Issue #1392 (write-from-Python / stale sidecar guards)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple fixes bundled under one ticket: write JSON sidecars from Python (not shell redirects) to avoid console-encoding corruption; flatten only content files (not code) into semantic extraction; guard empty extraction before any write; PROJECT_ROOT (not scan dir) for chunk paths."}, {"id": "_claude_skills_graphify_skill_issue1417", "label": "Issue #1417 (manifest relativized to scan root)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manifest keys are relativized to the scan root so the on-disk manifest is portable across clones/machines and --update matches cached files instead of missing every one after a move."}, {"id": "_claude_skills_graphify_skill_issue1948", "label": "Issue #1948 (clear stale semantic_hash on failed chunk)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A changed doc/paper/image whose extraction chunk failed must have its stale semantic_hash cleared so the next --update re-queues it instead of treating it as already-processed and losing its content."}, {"id": "_claude_skills_graphify_skill_issue2015", "label": "Issue #2015 (only stamp files that actually produced output)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only semantic files that actually produced extraction output get stamped as done in the manifest; a detected file whose chunk failed or was omitted must stay unstamped so it is retried next run."}], "edges": [{"source": "_claude_skills_graphify_skill_graphifycommand", "target": "_claude_skills_graphify_skill_structuralextraction", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphifycommand", "target": "_claude_skills_graphify_skill_semanticextraction", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_semanticextraction", "target": "_claude_skills_graphify_skill_geminibackend", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_structuralextraction", "target": "_claude_skills_graphify_skill_mergestep", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_semanticextraction", "target": "_claude_skills_graphify_skill_mergestep", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphifycommand", "target": "_claude_skills_graphify_skill_mergestep", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphifycommand", "target": "_claude_skills_graphify_skill_communitydetection", "relation": "implements", "confide